enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Order {
  id              Int             @id @default(autoincrement())
  shopId          Int             @map("shop_id")
  shop            Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopName        String          @map("shop_name")
  userId          Int?            @map("user_id")
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName        String          @map("full_name")
  phone           String
  address         String?
  note            String?
  fulfillmentType FulfillmentType @map("fulfillment_type")
  status          OrderStatus     @default(PENDING)
  itemsTotal      Decimal         @map("items_total") @db.Decimal(10, 2)
  deliveryFee     Decimal         @map("delivery_fee") @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  items           OrderItem[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([shopId, id])
  @@index([userId, id])
  @@map("orders")
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int             @map("order_id")
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int             @map("product_id")
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId   Int?            @map("variant_id")
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String          @map("product_name")
  brand       String?
  imageUrl    String?         @map("image_url")
  sku         String?
  ml          Int
  quantity    Int
  unitPrice   Decimal         @map("unit_price") @db.Decimal(10, 2)
  lineTotal   Decimal         @map("line_total") @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
